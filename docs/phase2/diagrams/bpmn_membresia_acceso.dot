digraph G { graph [rankdir=LR, bgcolor=white, pad=.25, nodesep=.35, ranksep=.5, label="FitZone — Subproceso: contratación, vigencia y acceso físico", labelloc=t, fontsize=16, fontname=Arial]; node [fontname=Arial, fontsize=10, style="rounded,filled", fillcolor="#F8F9F9", color="#455A64"]; edge [fontname=Arial, fontsize=9, color="#566573"];
subgraph cluster_s {label="LANE: Socio"; color="#2874A6"; start [shape=circle,label="Inicio",fillcolor="#D5F5E3"]; request [label="Solicita alta / renovación"] ; access [label="Presenta identificación"] ; end [shape=doublecircle,label="Fin",fillcolor="#D5F5E3"];}
subgraph cluster_r {label="LANE: Recepción / Administración"; color="#7D3C98"; register [label="Registrar datos del socio y plan"]; dates [label="Capturar fechas contractuales\n(inicio y fin)"];}
subgraph cluster_d {label="LANE: Sistema FitZone"; color="#239B56"; validate [label="Validar socio activo y\noperación autorizada"]; state [label="Aplicar Specification y\ntransición de estado"]; gate [shape=diamond,style=filled,fillcolor="#FCF3CF",label="¿Vigencia\nregistrada y válida?"]; allow [label="Permitir acceso y emitir evento"] ; deny [label="Denegar acceso con motivo",fillcolor="#FADBD8"];}
start -> request -> register -> validate -> state -> dates -> end;
access -> gate; gate -> allow [label="Sí"]; gate -> deny [label="No / falta dato"]; allow -> end; deny -> end;
}