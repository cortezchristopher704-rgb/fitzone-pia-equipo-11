digraph G { graph [rankdir=LR, bgcolor=white, pad=.25, nodesep=.35, ranksep=.5, label="FitZone — Subproceso: asistencia, no-show y continuidad de instructor", labelloc=t, fontsize=16, fontname=Arial]; node [fontname=Arial, fontsize=10, style="rounded,filled", fillcolor="#F8F9F9", color="#455A64"]; edge [fontname=Arial, fontsize=9, color="#566573"];
subgraph cluster_i {label="LANE: Instructor"; color="#CA6F1E"; roster [label="Consultar lista de inscritos"]; attendance [label="Registrar asistencia"]; absent [label="Reportar ausencia /\ncancelación de clase"] ;}
subgraph cluster_d {label="LANE: Sistema FitZone"; color="#239B56"; result [shape=diamond,style=filled,fillcolor="#FCF3CF",label="¿Asistió?"]; mark [label="Marcar ASISTIDA"]; noshow [label="Marcar NO_SHOW y\nactualizar contador mensual"]; gate [shape=diamond,style=filled,fillcolor="#FCF3CF",label="¿Llegó a 3\nno-shows?"]; block [label="Bloquear nuevas reservas\npor 7 días",fillcolor="#FDEBD0"]; available [shape=diamond,style=filled,fillcolor="#FCF3CF",label="¿Suplente disponible?"]; reassign [label="Reasignar instructor y\nencolar notificación"]; cancel [label="Cancelar clase, encolar avisos\ny ofrecer alternativas"]; outbox [label="Persistir notificaciones\nen outbox"];}
subgraph cluster_a {label="LANE: Administración"; color="#7D3C98"; choose [label="Seleccionar instructor suplente"]; report [label="Consultar reporte de\nasistencias / tasa no-show"];}
roster -> attendance -> result; result -> mark [label="Sí"]; result -> noshow [label="No"]; mark -> report; noshow -> gate; gate -> block [label="Sí"]; gate -> report [label="No"]; block -> report; absent -> available; available -> choose [label="Sí"]; choose -> reassign -> outbox; available -> cancel [label="No"]; cancel -> outbox;
}