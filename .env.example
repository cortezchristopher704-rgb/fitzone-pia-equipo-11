# ==============================================================================
# FitZone PIA — Configuración de Entorno (12-Factor App · Sin Secretos Reales)
# ==============================================================================

# Entorno de ejecución (development | testing | production)
APP_ENV=development

# Puerto de exposición HTTP para FastAPI / Uvicorn
PORT=8000

# Cadena de conexión a Base de Datos (SQLite local por defecto o PostgreSQL en Docker/Cloud)
DATABASE_URL=sqlite:///./fitzone_pia.sqlite3
# Ejemplo para Docker Compose / PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://fitzone_user:fitzone_pass_example@db:5432/fitzone_db

# Directorio de datos CSV de entrada
FITZONE_DATA_DIR=./datos

# Parámetros de reglas de negocio configurables (Principio Open/Closed)
FITZONE_CUTOFF_HORAS_SOCIO=3.0
FITZONE_CUTOFF_HORAS_INSTRUCTOR=2.0
FITZONE_MAX_NO_SHOWS_MES=3
FITZONE_DIAS_BLOQUEO_NOSHOW=7
FITZONE_VENTANA_ESPERA_MINUTOS=30

# Worker de tareas programadas
FITZONE_WORKER_INTERVAL_SECONDS=60
FITZONE_ALERTA_HORA=08:00
FITZONE_ALERTA_DIAS=7

# Tokens de personal para rutas protegidas (reemplazar por secretos aleatorios antes de usar)
FITZONE_STAFF_TOKEN_RECEPCION=change-this-reception-token
FITZONE_STAFF_TOKEN_INSTRUCTOR=change-this-instructor-token
FITZONE_STAFF_TOKEN_ADMIN=change-this-admin-token
