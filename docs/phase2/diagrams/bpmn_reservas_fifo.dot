digraph G { graph [rankdir=LR, bgcolor=white, pad=.25, nodesep=.35, ranksep=.5, label="FitZone — Subproceso: reserva, cancelación y lista de espera FIFO", labelloc=t, fontsize=16, fontname=Arial]; node [fontname=Arial, fontsize=10, style="rounded,filled", fillcolor="#F8F9F9", color="#455A64"]; edge [fontname=Arial, fontsize=9, color="#566573"];
subgraph cluster_s {label="LANE: Socio"; color="#2874A6"; start [shape=circle,label="Inicio",fillcolor="#D5F5E3"]; request [label="Solicita reservar"]; cancel [label="Cancela con ≥ 3 h\n(si aplica)"]; confirm [label="Confirma promoción\nen ≤ 30 min"]; end [shape=doublecircle,label="Fin",fillcolor="#D5F5E3"];}
subgraph cluster_d {label="LANE: Sistema FitZone"; color="#239B56"; eligible [label="Validar estado, vigencia,\nbloqueo, plan y límite"]; gate1 [shape=diamond,style=filled,fillcolor="#FCF3CF",label="¿Elegible?"]; gate2 [shape=diamond,style=filled,fillcolor="#FCF3CF",label="¿Hay cupo?"]; reserve [label="Confirmar reserva"]; queue [label="Encolar al final FIFO"]; release [label="Liberar cupo cancelado"]; promote [label="Promover primer socio FIFO\ny abrir ventana de 30 min"]; gate3 [shape=diamond,style=filled,fillcolor="#FCF3CF",label="¿Confirma?"]; expire [label="Expirar y promover\nal siguiente socio"];}
subgraph cluster_w {label="LANE: Worker"; color="#CA6F1E"; timer [shape=ellipse,label="Cada 60 segundos",fillcolor="#FDEBD0"]; scan [label="Buscar promociones\nvencidas"];}
start -> request -> eligible -> gate1; gate1 -> gate2 [label="Sí"]; gate1 -> end [label="No"]; gate2 -> reserve [label="Sí"]; gate2 -> queue [label="No"]; reserve -> end; queue -> end; cancel -> release -> promote -> confirm -> gate3; gate3 -> reserve [label="Sí"]; gate3 -> expire [label="No"]; timer -> scan -> expire; expire -> promote;
}